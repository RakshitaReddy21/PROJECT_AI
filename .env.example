# Aurelia AI Study Companion — Environment Variables Template
# Copy this file to .env or .env.local to configure real API providers.

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MOCK_MODE=false

# Google Gemini API Configuration (Server-Side Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Real SMTP Email Delivery Setup (For sending actual OTP verification emails to inboxes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-actual-email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM_EMAIL=your-actual-email@gmail.com
SMTP_FROM_NAME=AI Study Companion